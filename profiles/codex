# Owl profile: OpenAI Codex CLI
# https://learn.chatgpt.com/codex/non-interactive-mode
# https://learn.chatgpt.com/codex/config-file/config-reference
#
# Non-interactive mode uses the "exec" subcommand (p=exec).
# System prompt delivered via -c developer_instructions= (prefix concatenation).
# Sandbox: workspace-write allows file writes in the project directory.
# Memories are off by default in Codex.

agent=codex
p=exec
s=-c developer_instructions=
#model=o3

# Error signals: stop = abort run (file stays unmarked for resume),
# pause.N = sleep N seconds then retry.
error.stop=*401*
error.stop=*403*
error.stop=*insufficient_quota*
error.pause.60=*429*
error.pause.120=*503*

scan.memory=false
scan.forward=--sandbox
scan.forward=workspace-write

check.memory=true
check.forward=--sandbox
check.forward=workspace-write
